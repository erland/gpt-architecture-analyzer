{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Platform-neutral Artifact Contract",
  "type": "object",
  "required": ["contract_version", "outputs"],
  "properties": {
    "contract_version": {"type": "integer", "const": 1},
    "schema": {"type": "string", "minLength": 1},
    "outputs": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["kind", "format", "requirement", "persistence"],
        "properties": {
          "kind": {"enum": ["document", "package", "distribution", "report", "metadata", "data", "other"]},
          "format": {"type": "string", "minLength": 1},
          "requirement": {"enum": ["required", "conditional", "optional"]},
          "condition": {"type": "string"},
          "persistence": {"enum": ["persistent", "ephemeral"]},
          "multiplicity": {"enum": ["one", "many"]},
          "description": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
